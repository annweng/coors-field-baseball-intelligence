# PostgreSQL
POSTGRES_USER=cfbi
POSTGRES_PASSWORD=cfbi_dev_password
POSTGRES_DB=coors_field_bi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If 5432 is in use locally, set POSTGRES_PORT=5433 and match DATABASE_URL host port.
DATABASE_URL=postgresql+psycopg://cfbi:cfbi_dev_password@localhost:5432/coors_field_bi

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data pipeline
STATCAST_START_SEASON=2021
STATCAST_END_SEASON=2025
DATA_CACHE_DIR=./data/cache
PYBASEBALL_CACHE=./data/cache/pybaseball

# Models
MODEL_REGISTRY_DIR=./models/artifacts
RANDOM_SEED=42

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
